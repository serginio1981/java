{
  "name": "bingomaster",
  "productName": "BingoMaster",
  "version": "0.3.2",
  "description": "Conducción de bingos presenciales: panel del operador, pantalla pública, cartones con folio y validación",
  "author": "Sergio Aedo Mena",
  "private": true,
  "main": "out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "dist:win": "electron-vite build && electron-builder --win nsis --x64",
    "e2e": "electron-vite build && node tests/e2e/full.e2e.cjs",
    "smoke": "electron . --smoke-test",
    "dist:store": "electron-vite build && electron-builder --win appx --x64"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "electron": "^45.2.3",
    "electron-builder": "^26.18.0",
    "electron-vite": "^6.0.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.6",
    "vitest": "^5.1.0"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.6.0",
    "@google/genai": "^3.0.0",
    "openai": "^7.53.0"
  }
}
